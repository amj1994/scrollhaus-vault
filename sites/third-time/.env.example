# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Gumlet API key (Dashboard → Developer → API Keys)
GUMLET_API_KEY=

# Gumlet video source / workspace id
GUMLET_SOURCE_ID=

# Optional. Gumlet image-CDN origin used to serve optimized frames in
# production. Leave empty to serve the frames bundled in this repo.
# Example: https://<namespace>.gumlet.io/
ASSET_BASE=
